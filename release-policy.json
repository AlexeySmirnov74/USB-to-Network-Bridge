    "client-first-run",
    "usb-replug-different-port",
    "short-network-outage",
    "sleep-resume",
    "camera-controls-and-identity"
  ],
  "publication": "Only after the required qualification evidence passes; preserve Git history and publish source plus tested installer/portable assets.",
  "max_log_file_mib": 32,
